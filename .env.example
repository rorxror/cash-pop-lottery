# ---- Cash Pop Lottery — environment config ----
# Copy to .env and fill in. Every external integration is OPTIONAL:
# the site runs fully with everything unconfigured (graceful empty states).

# Server
PORT=3000
BASE_URL=http://localhost:3000
# Set to 1 when running behind real HTTPS (cPanel). Cookies become Secure.
FORCE_SSL=0

# Secrets (generate once; keep private)
SESSION_SECRET=change-me-to-a-long-random-string
TICKET_HMAC_SECRET=change-me-to-another-long-random-string

# Hidden admin panel path. Default is non-guessable; change it after install.
ADMIN_PATH=/ops-7f3a9c-console

# ---- Database ----
# Default: built-in SQLite file, zero config.
DB_DRIVER=sqlite
SQLITE_PATH=./data/cashpop.sqlite
# Optional MySQL (set DB_DRIVER=mysql and fill the rest):
# DB_DRIVER=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=cashpop
# MYSQL_PASSWORD=
# MYSQL_DB=cashpop

# ---- Google OAuth (optional; enter in Admin > Extensions too) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- reCAPTCHA (optional) ----
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---- SMTP for outgoing email (optional; Admin > Notifications > Email) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cash Pop <no-reply@example.com>"

# ---- Twilio SMS (optional; Admin > Notifications > SMS) ----
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
