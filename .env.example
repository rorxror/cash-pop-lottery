# Cash Pop Lottery — environment template. Copy to .env and fill in real
# values. NEVER commit a real .env. See README.md + docs/OPERATIONS.md.
# Every variable the code reads is listed here. Script-only variables
# (load tests, DB transfer tooling) are grouped at the bottom.

# Required: the app refuses to boot without a long TICKET_HMAC_SECRET.
TICKET_HMAC_SECRET=
# Required before saving any gateway credential (64 hex chars = 32 bytes):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also encrypts payout details at rest. Saves are REFUSED without it.
CREDENTIAL_ENCRYPTION_KEY=

# --- Core ---
PORT=
# REQUIRED in production: password-reset and email-verification links
# are built from BASE_URL and are NOT sent while it is unset (the app
# never falls back to a request's Host header for emailed links).
BASE_URL=
# PayPal API host override (testing/support only; leave unset for the
# mode-derived host: sandbox -> api-m.sandbox.paypal.com, live ->
# api-m.paypal.com).
PAYPAL_API_BASE_URL=
# Set to 1 behind a proxy that terminates HTTPS (forces secure redirects).
FORCE_SSL=
# The public /setup page stays DISABLED unless this is 1 (not recommended).
ALLOW_SETUP=
# Hidden admin path (boot-only; never editable from the admin panel).
# Change it from the default and keep it secret.
ADMIN_PATH=/ops-7f3a9c-console
# First admin seeded on a fresh DB only:
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=

# --- Database: sqlite (default) | postgres | mysql. A DATABASE_URL alone
# implies postgres; an explicit DB_DRIVER wins. Unknown DB_DRIVER throws.
DB_DRIVER=
DATABASE_URL=
# SQLite file (default ./data/cashpop.sqlite, resolved against app root).
SQLITE_PATH=
# KYC document uploads directory (default: a kyc-uploads folder next to
# the SQLite file — keep it on the same persistent disk, never in public/).
KYC_UPLOAD_DIR=
# MySQL (only when DB_DRIVER=mysql):
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
# Postgres (only when DB_DRIVER=postgres; PG* may replace DATABASE_URL):
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSLMODE=
# Opt-out ONLY for a trusted local/test Postgres (logs a warning):
PGSSL_INSECURE=

# --- Outgoing mail (SMTP): required for withdrawal OTP + notifications.
# Since v23 these can ALSO be set in the admin panel (Security →
# Delivery), stored encrypted; the panel values win, env is the
# fallback. Same for the SMS settings below.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMS: SMS_PROVIDER picks the provider; TEXTBELT_KEY is required for
# TextBelt (no shared-key fallback). Twilio uses the TWILIO_* vars.
SMS_PROVIDER=
TEXTBELT_KEY=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# OAuth sign-in (Google / Facebook) — create the apps with each provider:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# reCAPTCHA site key for the public widgets (secret lives in Extensions):
RECAPTCHA_SITE_KEY=
# Public randomness beacon for draw pinning (optional; see lib/draws.js):
DRAND_API=
# HaveIBeenPwned breached-password check on/off (1/0):
HIBP_CHECK=

# --- Tooling only (NOT read by the running app) ---
# Load test harness cookie:
LOADTEST_COOKIE=
# scripts/migrate-sqlite-to-postgres.js — target + safety guards:
TARGET_DATABASE_URL=
TRANSFER_TARGET_FINGERPRINT=
TRANSFER_WIPE_TARGET=
# Postgres adapter smoke test:
PG_TEST_URL=
