# Cash Pop Lottery — environment template (v17). Copy to .env and fill in
# real values. NEVER commit a real .env. See README-DEPLOY.md.
# Required: the app refuses to boot without a long TICKET_HMAC_SECRET.
TICKET_HMAC_SECRET=
# Required before saving any gateway credential (64 hex chars = 32 bytes):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=
# Database: sqlite (default) | postgres | mysql. A DATABASE_URL alone
# implies postgres; an explicit DB_DRIVER wins. Unknown DB_DRIVER throws.
DB_DRIVER=
DATABASE_URL=
# SQLite file (default ./data/cashpop.sqlite, resolved against app root).
SQLITE_PATH=
# MySQL (only when DB_DRIVER=mysql):
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
# Postgres (only when DB_DRIVER=postgres; PG* may replace DATABASE_URL):
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSLMODE=
# Opt-out ONLY for a trusted local/test Postgres (logs a warning):
PGSSL_INSECURE=
# Hidden admin path (boot-only; never editable from the admin panel):
ADMIN_PATH=/ops-7f3a9c-console
BASE_URL=
PORT=
# Outgoing mail (SMTP):
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMS: SMS_PROVIDER picks the provider; TEXTBELT_KEY is required for
# TextBelt (no shared-key fallback). Twilio uses the TWILIO_* vars.
SMS_PROVIDER=
TEXTBELT_KEY=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# OAuth (Google / Facebook sign-in):
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_SECRET=
# Public randomness beacon for draw pinning (optional; see draws.js):
DRAND_API=
# First admin seeded on a fresh DB only:
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=
