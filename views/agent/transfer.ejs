<section class="wrap section">
  <div class="agent-nav card">
    <a href="/agent">Dashboard</a>
    <a href="/agent/players">Players</a>
    <a href="/agent/players/new">Add Player</a>
    <a href="/agent/transfer" class="active">Transfer</a>
    <a href="/agent/commissions">Commissions</a>
    <a href="/agent/support">Support</a>
  </div>
</section>
<section class="wrap section narrow">
  <div class="form-card">
    <h1>Transfer to Player</h1>
    <p class="muted">Move funds from your agent float to a player's wallet.</p>
    <% if (typeof floatEmpty !== 'undefined' && floatEmpty) { %>
    <div class="flash f-err">Your float has no money in any currency yet, so transfers cannot be sent. Ask the admin to fund your float first — once it is funded, your balance will show next to each currency below.</div>
    <% } %>
    <form action="/agent/transfer" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="transfer_token" value="<%= typeof transferToken !== 'undefined' ? transferToken : '' %>">
      <div class="field">
        <label for="to_user_id">Player</label>
        <select id="to_user_id" name="to_user_id" required>
          <% (players || []).forEach(function(p){ %>
          <option value="<%= p.id %>"><%= p.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label for="currency">Currency</label>
        <select id="currency" name="currency" required>
          <% (floats || []).forEach(function(f){ %>
          <option value="<%= f.currency %>"><%= f.currency %> &middot; <%= fmt(f.balance, f.currency) %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <% /* AGENT-CURRENCY-01: the amount label follows the SELECTED
              currency (it was hardcoded "Amount (USD)"). Server renders
              the first listed currency; the nonce script keeps it in
              sync when the selection changes. */ %>
        <label for="amount">Amount (<span id="amtCur"><%= (floats && floats.length) ? floats[0].currency : '' %></span>)</label>
        <input type="number" id="amount" name="amount" min="0.01" step="0.01" required>
      </div>
      <script nonce="<%= cspNonce %>">
        (function () {
          var sel = document.getElementById('currency');
          var lab = document.getElementById('amtCur');
          if (sel && lab) sel.addEventListener('change', function () { lab.textContent = sel.value; });
        })();
      </script>
      <div class="field">
        <label for="note">Note (optional)</label>
        <input type="text" id="note" name="note" maxlength="140">
      </div>
      <button type="submit" class="btn btn-p btn-lg btn-block" data-confirm="Confirm this transfer?">Send Transfer</button>
    </form>
    <p class="mt"><a href="/agent">&larr; Back to dashboard</a></p>
  </div>
</section>
