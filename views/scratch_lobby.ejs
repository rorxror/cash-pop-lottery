<section class="section wrap">
  <div class="scratch-head">
    <div><span class="eyebrow">Instant games</span><h1>Scratch Cards</h1><p class="muted">Every outcome is locked before you scratch. Reveal is visual only.</p></div>
    <% if (user) { %><div class="scratch-actions"><a class="btn btn-g" href="/scratch/my-tickets">My Scratch Tickets</a><a class="btn btn-g" href="/scratch/responsible-play">Play Limits</a></div><% } %>
  </div>
  <% if (!series.length) { %>
    <div class="card empty-state"><h2>No scratch series on sale</h2><p class="muted">The operator has not launched an active series yet.</p></div>
  <% } else { %>
    <div class="scratch-grid">
      <% series.forEach(function(s){ const rtp = s.total_tickets ? (Number(s.total_prizes || 0) / (Number(s.total_tickets) * Number(s.price)) * 100) : 0; %>
      <article class="scratch-card type-<%= s.game_type %>">
        <div class="scratch-card-top"><span class="eyebrow"><%= s.game_type %></span><span class="status-dot">Live</span></div>
        <h2><%= s.title %></h2>
        <div class="scratch-metrics"><div><small>Price</small><strong><%= fmt(s.price,s.currency) %></strong></div><div><small>Top prize</small><strong><%= fmt(s.top_prize || 0,s.currency) %></strong></div><div><small>RTP</small><strong><%= rtp.toFixed(2) %>%</strong></div><div><small>Remaining</small><strong><%= s.remaining %></strong></div></div>
        <a class="btn btn-p btn-block" href="/scratch/<%= s.slug %>">View card</a>
      </article>
      <% }) %>
    </div>
  <% } %>
</section>
