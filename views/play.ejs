<% const _bundles = String(S('multi_draw_discounts') || '').split(',').map(x => x.trim()).filter(Boolean); %>
<% if (_bundles.length) { %><p class="muted wrap">🎁 Multi-draw bundles: <%= _bundles.map(b => { const [n, pc] = b.split(':'); return n + ' draws → ' + pc + '% off'; }).join(' · ') %></p><% } %>
<section class="wrap section">
  <h1 class="sec-title">Play &mdash; Build Your Slip</h1>
  <p class="muted">18+ only · Play responsibly — you can set deposit, loss and session limits at any time on the <a href="/scratch/responsible-play">Play Limits</a> page.</p>
  <form action="/play/buy" method="POST" id="playForm" class="play-grid" data-cur="<%= playCurrency %>" data-discounts="<%= S('multi_draw_discounts') %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <script type="application/json" id="prizeData"><%- JSON.stringify(prizeTable || []) %></script>

    <% /* R-071: wallet currency picker. The buy handler debits the wallet
         matching this currency (base only, before); without a picker a
         EUR-funded player could never spend their balance. Changing it
         reloads the slip so the shown balance matches the wallet used. */ %>
    <div class="pstep">
      <div class="field"><label for="playCurrency">Wallet currency</label>
      <select name="currency" id="playCurrency">
        <% const _funded = (wallets || []).filter(function(w){ return Number(w.balance) > 0; }).map(function(w){ return w.currency; }); %>
        <% const _opts = _funded.indexOf(playCurrency) === -1 ? _funded.concat([playCurrency]) : _funded; %>
        <% _opts.forEach(function(c){ %><option value="<%= c %>"<%= c === playCurrency ? ' selected' : '' %>><%= c %></option><% }); %>
      </select></div>
      <p class="muted">Your ticket is debited from this wallet. Funded wallets only, plus your current selection.</p>
    </div>

    <div class="pslip">
      <% /* STEP 1 */ %>
      <div class="pstep">
        <div class="pstep-banner"><span class="pstep-num">1</span><span>Pick your pops</span></div>
        <p class="pstep-sub">Play just 1 or up to 15 numbers (pops). The more numbers you play, the better your odds of winning!</p>
        <div class="balls" id="ballBox">
          <% for (let i=1; i<=15; i++) { %>
          <label class="ball-wrap"><input type="checkbox" name="pops" value="<%= i %>" class="ball-input"><span class="ball"><%= i %></span></label>
          <% } %>
        </div>
        <div class="ball-actions">
          <button type="button" class="btn btn-g btn-sm" id="coverAll" aria-pressed="false">Cover All</button>
          <button type="button" class="btn btn-g btn-sm" id="quickPick">Quick Pick</button>
          <button type="button" class="btn btn-g btn-sm" id="clearBalls">Clear</button>
        </div>
        <p class="muted"><span id="popCount">0</span> pops selected</p>
      </div>

      <% /* STEP 2 */ %>
      <div class="pstep">
        <div class="pstep-banner"><span class="pstep-num">2</span><span>Select your wager per pop</span></div>
        <p class="pstep-sub">The more you wager, the higher the cash prize you could win!</p>
        <div class="wager-circles" id="wagerBox">
          <% wagerOptions.forEach(function(w, idx){ %>
          <label class="circle-wrap"><input type="radio" name="wager" value="<%= w %>" class="circle-input"<%= idx===0 ? ' checked' : '' %>><span class="circle-ball wager-ball"><%= fmt(w, playCurrency) %></span></label>
          <% }) %>
        </div>
      </div>

      <% /* STEP 3 */ %>
      <div class="pstep">
        <div class="pstep-banner"><span class="pstep-num">3</span><span>Select draw &amp; number of draws</span></div>
        <p class="pstep-sub">Choose your draw time(s), then how many consecutive draws to play.</p>
        <div class="circle-row-label">Draw time</div>
        <div class="draw-circles" id="drawTypeBox">
          <label class="circle-wrap"><input type="radio" name="draw_type" value="DAY" class="circle-input" checked><span class="circle-ball draw-ball">Day</span></label>
          <label class="circle-wrap"><input type="radio" name="draw_type" value="EVE" class="circle-input"><span class="circle-ball draw-ball">Eve</span></label>
          <label class="circle-wrap"><input type="radio" name="draw_type" value="BOTH" class="circle-input"><span class="circle-ball draw-ball">Both</span></label>
        </div>
        <div class="circle-row-label">Number of draws</div>
        <div class="draw-circles" id="numDrawsBox">
          <% for (let n=1; n<=maxDraws; n++) { %>
          <label class="circle-wrap"><input type="radio" name="num_draws" value="<%= n %>" class="circle-input"<%= n===1 ? ' checked' : '' %>><span class="circle-ball draw-ball num-ball"><%= n %></span></label>
          <% } %>
        </div>
        <p class="muted note">Both = your pops enter the Day draw <em>and</em> the Evening draw each day.</p>
      </div>

      <% /* PRIZES */ %>
      <% if (prizeTable && prizeTable.length) { %>
      <div class="pstep">
        <div class="pstep-banner prize-banner"><span class="pstep-num">$</span><span>Prize multipliers</span></div>
        <p class="pstep-sub">Match your number to the drawn number to win the multiplier for your pops.</p>
        <div class="tbl-wrap">
        <table class="tbl tbl-sm prize-tbl">
          <thead><tr><th>Pops played</th><th>Multiplier</th><th>Win per <%= fmt(100, playCurrency) %> wager</th></tr></thead>
          <tbody>
            <% prizeTable.forEach(function(p){ %>
            <tr><td><%= p.pops_count %></td><td>&times;<%= p.multiplier %></td><td><%= fmt(p.multiplier * 100, playCurrency) %></td></tr>
            <% }) %>
          </tbody>
        </table>
        </div>
      </div>
      <% } %>
    </div>

    <% /* SLIP SUMMARY */ %>
    <div class="card slip-card" id="totalBox">
      <div class="card-h"><h2>Your slip</h2><button type="button" id="slipToggle" class="btn btn-g btn-sm">Hide</button></div>
      <div id="slipBreakdown" class="slip-lines">
        <div class="slip-line"><span>Pops</span><span id="slPops">0</span></div>
        <div class="slip-line"><span>Wager each</span><span id="slWager"><%= fmt(wagerOptions[0], playCurrency) %></span></div>
        <div class="slip-line"><span>Draws</span><span id="slDraws">1 &times; Day</span></div>
      </div>
      <p class="muted" id="prizePreview"></p>
      <div class="slip-total"><span>Total cost</span><span id="totalAmt"><%= fmt(0, playCurrency) %></span></div>
      <p class="muted">Wallet balance: <%= fmt(balance, playCurrency) %></p>
      <button type="submit" class="btn btn-p btn-lg btn-block" id="buyBtn">Buy Ticket &mdash; <span id="totalAmtBtn"><%= fmt(0, playCurrency) %></span></button>
    </div>
  </form>
</section>
