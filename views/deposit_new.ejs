<section class="wrap section">
  <h1 class="sec-title">New Deposit</h1>
  <p class="muted">18+ only · Play responsibly — you can set deposit, loss and session limits at any time on the <a href="/scratch/responsible-play">Play Limits</a> page.</p>
  <div class="grid2">
    <div class="card">
      <div class="card-h"><h2>Payment method</h2></div>
      <% /* CURRENCY-SYSTEM-01: the player's own currency group first,
             foreign methods under their own heading, every method
             tagged with its currency — never silently foreign. */ %>
      <ul class="method-list">
        <% var _seenOther = false; (methods || []).forEach(function(m){ var _mine = (typeof myCur !== 'undefined' && m.currency === myCur); %>
        <% if (!_mine && !_seenOther) { _seenOther = true; %><li class="method-group">Other currencies</li><% } %>
        <li class="<%= method && method.id === m.id ? 'sel' : '' %>">
          <span class="method-name"><%= m.name %> <span class="muted">(<%= m.currency %>)</span></span>
          <a class="btn <%= method && method.id === m.id ? 'btn-p' : 'btn-g' %> btn-sm" href="/deposit/new?m=<%= m.id %>">Select</a>
        </li>
        <% }) %>
      </ul>
    </div>
    <div class="card">
      <% if (method) { %>
      <div class="card-h"><h2><%= method.name %></h2></div>
      <div class="instruction"><%- content('deposit_instruction_' + method.id) %><% /* INSTR-APPLE-01: the how-to IS the mode text — auto methods render the rail autoInstruction, manual methods the numbered manual steps (switched in the route); the two are never mixed. Multi-line text renders as a numbered step list. */ %><% if (method.instruction) { const _steps = String(method.instruction).split(/\n+/).map(function(x){ return x.trim(); }).filter(Boolean); if (_steps.length > 1) { %><ol class="howto-steps"><% _steps.forEach(function(st){ %><li><%= st.replace(/^\d+[.)]\s*/, '') %></li><% }) %></ol><% } else { %><p class="muted pre"><%= method.instruction %></p><% } } %>
      </div>
      <% if (typeof receiving !== 'undefined' && receiving && receiving.length) { %>
      <div class="instruction">
        <p><strong>Send your payment to:</strong></p>
        <% receiving.forEach(function(r){ %>
        <% if (r.key === 'qr_image_url') { %><p><img src="<%= r.value %>" alt="Payment QR code" style="max-width:220px"></p><% } else { %><p class="muted"><%= r.label %>: <strong class="code"><%= r.value %></strong></p><% } %>
        <% }) %>
      </div>
      <% } %>
      <% /* HOTFIX 2026-10-29 (owner-reported on live v21): the U-21
            "Payment gateway details" block that used to render here is
            REMOVED. It displayed gateway configuration values (incl.
            the PayPal Client ID, whitelisted in PUBLIC_CONFIG_FIELDS)
            to players although nothing on this page consumes them —
            no checkout button, no JS. Player pages show pay-to
            (receiving) details and instructions ONLY; every credential
            value stays admin-side. Regression test:
            test/player-credential-leak.test.js */ %>
      <form action="/deposit/new" method="POST" id="depositForm">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="method_id" value="<%= method.id %>">
        <div class="field">
          <label for="depAmount">Amount (<%= method.currency %>)</label>
          <input type="number" id="depAmount" name="amount" min="<%= method.min_amount ? (method.min_amount / Math.pow(10, methodDec)) : '' %>" max="<%= method.max_amount ? (method.max_amount / Math.pow(10, methodDec)) : '' %>" required
                 data-fixed="<%= method.fixed_charge %>" data-percent="<%= method.percent_charge %>" data-currency="<%= method.currency %>" data-decimals="<%= methodDec %>">
          <small class="muted"><% if (method.min_amount) { %>Min <%= fmt(method.min_amount, method.currency) %><% if (typeof minEquiv !== 'undefined' && minEquiv) { %> (&asymp; <%= minEquiv %>)<% } %><% } %><% if (method.min_amount && method.max_amount) { %> &middot; <% } %><% if (method.max_amount) { %>Max <%= fmt(method.max_amount, method.currency) %><% if (typeof maxEquiv !== 'undefined' && maxEquiv) { %> (&asymp; <%= maxEquiv %>)<% } %><% } %><% if (!method.min_amount && !method.max_amount) { %>No limits<% } %></small>
          <% if (typeof rateNote !== 'undefined' && rateNote) { %><small class="muted"><%= rateNote %></small><% } %>
        </div>
        <p class="muted" id="chargePreview"></p>
        <% (method.custom_fields || []).forEach(function(f){ %>
        <div class="field">
          <label for="cf_<%= f.key %>"><%= f.label %><%= f.required ? ' *' : '' %></label>
          <input type="text" id="cf_<%= f.key %>" name="custom_<%= f.key %>" <%= f.required ? 'required' : '' %>>
        </div>
        <% }) %>
        <button type="submit" class="btn btn-p btn-lg btn-block">Submit Deposit</button>
      </form>
      <% } else if (typeof noMethods !== 'undefined' && noMethods) { %>
      <p class="muted">No payment methods are available right now. Please check back later or contact support.</p>
      <p><a class="btn btn-g" href="/wallet">Back to wallet</a></p>
      <% } else { %>
      <p class="muted">Select a payment method to continue.</p>
      <% } %>
    </div>
  </div>
</section>
