<section class="wrap section narrow">
  <div class="form-card">
    <h1>Profile</h1>
    <div class="verify-badges">
      <span class="badge <%= user.status === 'active' ? 'b-ok' : 'b-warn' %>"><%= user.status %></span>
    </div>
    <form action="/profile" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <label for="name">Full name</label>
        <input type="text" id="name" name="name" value="<%= user.name %>" required>
      </div>
      <div class="field">
        <label>Email</label>
        <input type="email" value="<%= user.email %>" disabled readonly>
        <small class="muted">Email cannot be changed here &mdash; contact support.</small>
      </div>
      <div class="field">
        <label for="phone">Phone</label>
        <input type="tel" id="phone" name="phone" value="<%= user.phone || '' %>">
      </div>
      <div class="field">
        <label for="country">Country</label>
        <input type="text" id="country" name="country" value="<%= user.country || '' %>">
      </div>
      <button type="submit" class="btn btn-p btn-lg btn-block">Save Changes</button>
    </form>
    <div class="card mt">
      <div class="card-h"><h2>Contact verification</h2></div>
      <p class="muted">A verified email or phone is required before depositing or withdrawing (operator setting). If you cannot receive a code, contact support — staff can attest your contact manually.</p>
      <p>Email: <%= user.email_verified ? '<span class="badge b-ok">&#10003; verified</span>' : '<span class="badge b-warn">not verified</span>' %>
        <% if (!user.email_verified) { %><form method="POST" action="/profile/verify-email" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-p" type="submit">Send verification link</button></form><% } %></p>
      <p>Phone: <%= user.mobile_verified ? '<span class="badge b-ok">&#10003; verified</span>' : '<span class="badge b-warn">not verified</span>' %>
        <% if (!user.mobile_verified && user.phone) { %><form method="POST" action="/profile/verify-phone" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-p" type="submit">Send code</button></form><% } else if (!user.mobile_verified) { %><span class="muted">Add a phone number above first.</span><% } %></p>
      <% if (typeof verifyPhone !== 'undefined' && verifyPhone) { %>
      <form method="POST" action="/profile/verify-phone/confirm">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field"><label for="phoneCode">Phone code</label><input type="text" id="phoneCode" name="code" required autocomplete="off"></div>
        <button class="btn btn-p" type="submit">Confirm phone</button>
      </form>
      <% } %>
    </div>
    <% if (user.referral_code) { %>
    <div class="login-branding">
      <div class="login-jackpot">🔗 Your referral link</div>
      <p class="muted sm">Share this link — when friends register with it and buy tickets, you earn referral commission (when enabled by the operator).</p>
      <p><span class="code" id="refLink"><%= (typeof baseUrl !== 'undefined' && baseUrl ? baseUrl : '') %>/register?ref=<%= user.referral_code %></span></p>
    </div>
    <% } %>
  </div>
</section>
