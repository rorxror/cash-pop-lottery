<section class="wrap section narrow">
  <div class="form-card">
    <h1>Forgot Password</h1>
    <% if (typeof sent !== 'undefined' && sent) { %>
    <div class="flash f-ok">If that email is registered, a reset link is on its way. Please check your email &mdash; or contact support if nothing arrives.</div>
    <p class="muted"><a href="/login">Back to login</a></p>
    <% } else { %>
    <p class="muted">Enter your account email and we'll send you a password reset link.</p>
    <form action="/forgot" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autocomplete="email">
      </div>
      <%- captchaHtml %>
      <%- recaptchaHtml %>
      <button type="submit" class="btn btn-p btn-lg btn-block">Send Reset Link</button>
    </form>
    <p class="muted"><a href="/login">Back to login</a></p>
    <% } %>
  </div>
</section>
