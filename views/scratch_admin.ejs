<section class="section wrap"><div class="scratch-head"><div><span class="eyebrow">Admin control room</span><h1>Scratch Series</h1><p class="muted">Create inventory, review payout math, launch, pause and stop series. Individual outcomes cannot be edited.</p></div><a class="btn btn-g" href="<%= adminPath %>">Admin dashboard</a></div><div class="admin-scratch-grid"><div class="card"><h2>Create draft series</h2><form action="<%= adminPath %>/scratch/create" method="POST" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Title<input name="title" required maxlength="120"></label><label>Slug<input name="slug" placeholder="auto-from-title"></label><label>Game type<select name="game_type"><option value="single">Single reveal</option><option value="match3">Match three</option><option value="six">Six windows</option><option value="bonus">Bonus gate</option></select></label><div class="grid2"><label>Currency<input name="currency" value="USD" maxlength="8"></label><label>Ticket price<input name="price" type="number" min="0.01" step="0.01" value="1.00" required></label></div><label>Total tickets<input name="total_tickets" type="number" min="1" max="1000000" value="100" required></label><label>Prize tiers <small class="muted">one per line: amount:quantity:label</small><textarea name="tiers" rows="5" required>1.00:50:$1 prize</textarea></label><label>Rules<textarea name="rules" rows="3"></textarea></label><button class="btn btn-p btn-block" type="submit">Create draft</button></form></div><div class="series-stack"><% series.forEach(function(s){ const rtp=s.total_tickets?(Number(s.prize_pool)/(Number(s.total_tickets)*Number(s.price))*100):0; %><article class="card"><div class="scratch-card-top"><span class="eyebrow"><%= s.game_type %></span><span class="badge"><%= s.status %> · <%= s.enabled?'enabled':'disabled' %></span></div><h2><%= s.title %></h2><div class="scratch-metrics"><div><small>Inventory</small><strong><%= s.sold %>/<%= s.total_tickets %></strong></div><div><small>RTP</small><strong><%= rtp.toFixed(2) %>%</strong></div><div><small>Revenue</small><strong><%= fmt(s.revenue,s.currency) %></strong></div><div><small>Paid</small><strong><%= fmt(s.paid,s.currency) %></strong></div></div><div class="code">Seed commit: <%= s.seed_hash %></div><div class="scratch-actions"><% if(s.status==='draft'){ %><form action="<%= adminPath %>/scratch/<%= s.id %>/launch" method="POST"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-p" type="submit">Launch</button></form><% } %><% if(s.status==='live'){ %><form action="<%= adminPath %>/scratch/<%= s.id %>/toggle" method="POST"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-g" type="submit"><%= s.enabled?'Pause sale':'Resume sale' %></button></form><form action="<%= adminPath %>/scratch/<%= s.id %>/stop" method="POST"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-g" type="submit">Stop &amp; reveal seed</button></form><% } %></div></article><% }) %></div></div></section>
