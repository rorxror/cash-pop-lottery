<section class="wrap section narrow">
  <div class="form-card auth-card fade-in">
    <div class="auth-logo">🎰</div>
    <h1>Complete your profile</h1>
    <p class="login-value">Just one step left — your full name and agreement to the Terms &amp; Privacy Policy.</p>
    <form method="POST" action="/login/complete-profile">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <label for="cpName">Full name</label>
        <input type="text" id="cpName" name="name" placeholder="Your full name" autocomplete="name" required>
      </div>
      <label class="check">
        <input type="checkbox" name="agree" value="1" required>
        <span>I accept the Terms &amp; Privacy Policy.</span>
      </label>
      <button class="btn btn-p btn-block" type="submit">Continue</button>
    </form>
    <form method="POST" action="/logout" style="margin-top:12px">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <p class="muted">Already have an account? <button type="submit" class="linklike">Sign out</button> and sign in again.</p>
    </form>
  </div>
</section>
