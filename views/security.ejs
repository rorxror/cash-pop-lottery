<section class="wrap section narrow">
  <div class="form-card">
    <span class="eyebrow">Authenticator security</span>
<% if (typeof formError !== 'undefined' && formError) { %><div class="flash f-err"><%= formError %></div><% } %>
        <div class="sec-head">
      <h1>Two-factor authentication</h1>
      <% if (typeof totpEnabled !== 'undefined' && totpEnabled) { %>
      <span class="badge b-ok">Enrolled</span>
      <% } else { %>
      <span class="badge b-err">Not enrolled</span>
      <% } %>
    </div>
    <% if (typeof totpEnabled !== 'undefined' && totpEnabled) { %>
    <p class="muted">Two-factor authentication is active on your account. You will be asked for a code from your authenticator app at login.</p>
    <h3>Disable 2FA</h3>
    <form action="/security/totp/disable" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <label for="password">Confirm your password</label>
        <input type="password" id="password" name="password" required autocomplete="current-password">
      </div>
      <div class="field">
        <label for="disable_totp_code">Authenticator code (or a backup code)</label>
        <input type="text" id="disable_totp_code" name="totp_code" inputmode="numeric" autocomplete="one-time-code" required>
      </div>
      <button type="submit" class="btn btn-d" data-confirm="Disable two-factor authentication?">Disable 2FA</button>
    </form>
    <h3 class="mt">Backup codes</h3>
    <p class="muted">Regenerating invalidates all previously issued codes. Store the new codes somewhere safe.</p>
    <form action="/security/totp/backup" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <label for="backup_password">Confirm your password</label>
        <input type="password" id="backup_password" name="password" required autocomplete="current-password">
      </div>
      <div class="field">
        <label for="backup_totp_code">Authenticator code (or a backup code)</label>
        <input type="text" id="backup_totp_code" name="totp_code" inputmode="numeric" autocomplete="one-time-code" required>
      </div>
      <button type="submit" class="btn btn-g" data-confirm="Regenerate backup codes? Old codes will stop working.">Regenerate backup codes</button>
    </form>
    <% if (typeof showBackup !== 'undefined' && showBackup && backupCodes && backupCodes.length) { %>
    <div class="alert a-ok mt">
      <p><strong>Your new backup codes</strong> &mdash; shown only once:</p>
      <ul class="code-list">
        <% backupCodes.forEach(function(c){ %><li class="code"><%= c %></li><% }) %>
      </ul>
    </div>
    <% } %>
    <% } else { %>
    <p class="muted">Two-factor authentication is not enabled yet. Enable it to protect your funds.</p>
    <% if (typeof showSetup !== 'undefined' && showSetup && setup) { %>
    <h3>Scan the QR code</h3>
    <img src="<%= setup.qrDataUrl %>" alt="TOTP QR code" class="qr">
    <p class="muted">Or enter this secret manually: <span class="code"><%= setup.secret %></span></p>
    <form action="/security/totp/confirm" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <label for="confirm_password">Confirm your password</label>
        <input type="password" id="confirm_password" name="password" required autocomplete="current-password">
      </div>
      <div class="field">
        <label for="totp_code">Confirmation code</label>
        <input type="text" id="totp_code" name="totp_code" inputmode="numeric" autocomplete="one-time-code" required>
      </div>
      <button type="submit" class="btn btn-p">Confirm &amp; Enable</button>
    </form>
    <% } else if (typeof hasPassword !== 'undefined' && !hasPassword) { %>
    <p class="muted">Set a password on your account first (use the Set a password form below), then enable two-factor authentication.</p>
    <% } else { %>
    <form action="/security/totp/start" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <label for="enroll_password">Confirm your password</label>
        <input type="password" id="enroll_password" name="password" required autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn-p btn-lg btn-block">Set up 2FA</button>
    </form>
    <% } %>
    <% } %>
  </div>
</section>

<section class="wrap section narrow">
<% /* R-122: logged-in password change */ %>
<div class="card" style="margin-top:16px">
  <h2><%= (typeof hasPassword !== 'undefined' && !hasPassword) ? 'Set a password' : 'Change password' %></h2>
  <% if (typeof hasPassword !== 'undefined' && !hasPassword) { %><p class="muted sm">You signed in with a social account or a one-time code, so your account has no password yet. Set one to unlock every security option (including two-factor settings) and to be able to sign in with a password.</p><% } %>
  <form method="POST" action="/security/password">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% if (typeof hasPassword === 'undefined' || hasPassword) { %><div class="field"><label for="curPw">Current password</label><input type="password" id="curPw" name="current_password" required></div><% } %>
    <div class="field"><label for="newPw">New password</label><input type="password" id="newPw" name="password" required></div>
    <div class="field"><label for="newPw2">Confirm new password</label><input type="password" id="newPw2" name="password2" required></div>
    <button type="submit" class="btn btn-p"><%= (typeof hasPassword !== 'undefined' && !hasPassword) ? 'Set password' : 'Change password' %></button>
  </form>
  <p class="muted sm">Changing your password signs out all other sessions.</p>
</div>

<% /* BP-14 (v19) + U-04c (v20): own sessions from the DB session store,
     rebuilt as stacked .v20-session cards (no wide table). The view model
     (routes/player.js securityViewModel) supplies HUMAN fields only —
     deviceLabel / device / browser / os — the raw user-agent never
     reaches this view. Only fields the store really records are shown
     (sign-in time, IP, expiry); there is no last-activity tracking, so
     none is claimed. Current session: s.id === currentSessionId, the
     field the view model provides (same comparison the v19 table used). */ %>
<% if (typeof sessions !== 'undefined' && sessions) { %>
<div class="card" style="margin-top:16px">
  <h2>Active sessions</h2>
  <p class="muted sm">These are the devices currently signed in to your account, exactly as recorded when each sign-in happened.</p>
  <% if (sessions.length) { %>
  <div class="v20-session-list">
    <% sessions.forEach(function(s){ var isCurrent = (typeof currentSessionId !== 'undefined' && s.id === currentSessionId); %>
    <div class="v20-session-card<%= isCurrent ? ' v20-session-card--current' : '' %>">
      <div><strong><%= s.deviceLabel %></strong></div>
      <% if (isCurrent) { %><span class="v20-session-badge">This session</span><% } %>
      <p class="v20-session-meta"><strong>Device:</strong> <%= s.device %><% if (s.os) { %> &middot; <strong>System:</strong> <%= s.os %><% } %> &middot; <strong>Browser:</strong> <%= s.browser %></p>
      <p class="v20-session-meta"><strong>Signed in to:</strong> <%= s.scopeLabel || 'Website' %></p>
      <p class="v20-session-meta"><strong>IP address:</strong> <%= s.ip || '—' %></p>
      <p class="v20-session-meta"><strong>Signed in:</strong> <%= new Date(s.created_at).toLocaleString() %></p>
      <p class="v20-session-meta"><strong>Expires:</strong> <%= new Date(s.expires_at).toLocaleString() %></p>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <p class="muted">No active sessions.</p>
  <% } %>
  <% if (sessions.length > 1) { %>
  <form method="POST" action="/security/sessions/revoke" style="margin-top:12px">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button type="submit" class="btn btn-d">Sign out all other sessions</button>
  </form>
  <% } %>
</div>
<% } %>
</section>
