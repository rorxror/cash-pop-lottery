<section class="section wrap narrow-wide"><a class="back-link" href="/scratch/ticket/<%= ticket.public_id %>">← Ticket</a><div class="card"><span class="eyebrow">Provably fair</span><h1>Verify Scratch Ticket</h1><p><strong><%= ticket.title %></strong> · <span class="code"><%= ticket.public_id %></span></p><div class="verify-stack"><div><small>Stored before reveal</small><div class="code"><%= ticket.commitment %></div></div><% if (ticket.status==='revealed') { %><div><small>Revealed nonce</small><div class="code"><%= ticket.nonce %></div></div><div><small>Recomputed commitment</small><div class="code"><%= computed %></div></div><div class="verify-status <%= valid?'ok':'bad' %>"><%= valid?'Verified — the revealed outcome matches the pre-reveal commitment.':'Verification failed — contact support.' %></div><% } else { %><div class="verify-status">Scratch the ticket first. The prize and nonce stay hidden until reveal.</div><% } %></div></div></section>
