<section class="wrap section">
  <h1 class="sec-title">Wallet</h1>
  <p class="muted">18+ only · Play responsibly — you can set deposit, loss and session limits at any time on the <a href="/scratch/responsible-play">Play Limits</a> page.</p>
  <% if (typeof kycNotice !== 'undefined' && kycNotice) { %>
  <div class="card" style="border-left:4px solid #c98a00">
    <div class="card-h"><h2>Identity verification (KYC) — <%= kycNotice.statusLabel %></h2></div>
    <% if (kycNotice.withdrawBlocked || kycNotice.depositBlocked) { %>
    <p>KYC approval is required before <%= kycNotice.withdrawBlocked && kycNotice.depositBlocked ? 'deposits and withdrawals' : (kycNotice.withdrawBlocked ? 'withdrawals' : 'deposits') %> on your account. <a href="/kyc">Go to the KYC page</a> to submit your document.</p>
    <% } else if (kycNotice.status === 'rejected') { %>
    <p>Your last KYC submission was rejected<% if (kycNotice.note) { %>: <strong><%= kycNotice.note %></strong><% } %>. <a href="/kyc">Submit a new document</a>.</p>
    <% } else if (kycNotice.status === 'verified') { %>
    <p>Your identity is verified — no action is needed.</p>
    <% } else if (kycNotice.status === 'pending') { %>
    <p>Your KYC document is under review. <a href="/kyc">Check the status</a>.</p>
    <% } %>
  </div>
  <% } %>
  <h2 class="sec-title">Balances</h2>
  <div class="cur-rows">
    <% (typeof wallets !== 'undefined' ? wallets : []).forEach(function(w){
         var cinfo = ((typeof currencies !== 'undefined' ? currencies : []).filter(function(c){ return c.code === w.currency; })[0]) || {};
    %>
    <div class="cur-row">
      <span class="cr-name"><%= w.currency %> <span class="cr-sym"><%= cinfo.symbol || '' %></span></span>
      <span class="cr-bal"><%= fmt(w.balance, w.currency) %></span>
      <% /* U-01: the old fallback was the STRING '&nbsp;' sent through the
            escaped-output tag, which printed the literal text "&nbsp;".
            Empty means empty. */ %>
      <span class="cr-meta"><%= (cinfo.rate && w.currency !== (typeof baseCur !== 'undefined' ? baseCur : 'USD')) ? ('1 ' + (typeof baseCur !== 'undefined' ? baseCur : 'USD') + ' = ' + Number(cinfo.rate).toFixed(4) + ' ' + w.currency) : '' %></span>
    </div>
    <% }) %>
  </div>
  <% if (typeof totalApprox !== 'undefined' && totalApprox) { %>
  <p class="mt"><strong>Total (approx): <%= totalApprox %></strong> <span class="muted">— all balances converted to your currency (<%= myCur %>) at the admin-set rate. Amounts stay stored in their own currencies; this total is for reading only.</span></p>
  <% } %>

  <div class="card mt">
    <div class="card-h"><h2>Exchange</h2></div>
    <p class="muted">Move money between your own wallets at the <strong>admin-set rate</strong> (Settings &rarr; Currencies — this is not a live market rate).<% if (typeof exchangeFeePercent !== 'undefined' && exchangeFeePercent > 0) { %> Fee: <%= exchangeFeePercent %>% of the converted amount, shown before you confirm.<% } %></p>
    <% if (typeof exchangePreview !== 'undefined' && exchangePreview) { %>
    <div class="alert a-ok">
      <p><strong>Check your exchange:</strong> you give <strong><%= fmt(exchangePreview.amount, exchangePreview.from) %></strong> &rarr; you receive <strong><%= fmt(exchangePreview.credit, exchangePreview.to) %></strong><% if (exchangePreview.fee > 0) { %> (fee <%= fmt(exchangePreview.fee, exchangePreview.to) %> included)<% } %>.</p>
      <p class="muted">Admin-set rate: 1 <%= exchangePreview.from %> = <%= (exchangePreview.rateTo / exchangePreview.rateFrom).toFixed(4) %> <%= exchangePreview.to %>.</p>
      <form action="/wallet/exchange" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="from_currency" value="<%= exchangePreview.from %>">
        <input type="hidden" name="to_currency" value="<%= exchangePreview.to %>">
        <input type="hidden" name="amount" value="<%= exchangePreview.amountMajor %>">
        <button type="submit" class="btn btn-p">Confirm exchange</button>
        <a class="btn btn-g" href="/wallet">Cancel</a>
      </form>
    </div>
    <% } %>
    <form action="/wallet/exchange/preview" method="POST" class="adm-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field"><label for="exFrom">From wallet</label>
        <select id="exFrom" name="from_currency"><% (typeof wallets !== 'undefined' ? wallets : []).forEach(function(w){ %><option value="<%= w.currency %>"><%= w.currency %> — <%= fmt(w.balance, w.currency) %></option><% }) %></select></div>
      <div class="field"><label for="exTo">To wallet</label>
        <select id="exTo" name="to_currency"><% (typeof currencies !== 'undefined' ? currencies : []).forEach(function(c){ %><option value="<%= c.code %>"><%= c.code %></option><% }) %></select></div>
      <div class="field"><label for="exAmt">Amount (in the From currency)</label><input type="number" step="0.01" min="0" id="exAmt" name="amount" required></div>
      <button type="submit" class="btn btn-p">Preview exchange</button>
    </form>
  </div>

  <div class="grid2 mt">
    <div class="card">
      <div class="card-h"><h2>Deposit</h2></div>
      <% if (depositMethods && depositMethods.length) { %>
      <ul class="method-list">
        <% depositMethods.forEach(function(m){ %>
        <li>
          <span class="method-name"><%= m.name %></span>
          <span class="muted"><% if (m.min_amount == null && m.max_amount == null) { %>No limits<% } else { %><%= m.min_amount == null ? '' : fmt(m.min_amount, m.currency) %><%= m.min_amount == null || m.max_amount == null ? '' : ' – ' %><%= m.max_amount == null ? 'no max' : fmt(m.max_amount, m.currency) %><% } %></span>
          <a class="btn btn-p btn-sm" href="/deposit/new?m=<%= m.id %>">Deposit</a>
        </li>
        <% }) %>
      </ul>
      <% } else { %><p class="muted">No deposit methods available.</p><% } %>
    </div>
    <div class="card">
      <div class="card-h"><h2>Withdraw</h2></div>
      <% if (withdrawMethods && withdrawMethods.length) { %>
      <ul class="method-list">
        <% withdrawMethods.forEach(function(m){ %>
        <li>
          <span class="method-name"><%= m.name %></span>
          <span class="muted"><% if (m.min_amount == null && m.max_amount == null) { %>No limits<% } else { %><%= m.min_amount == null ? '' : fmt(m.min_amount, m.currency) %><%= m.min_amount == null || m.max_amount == null ? '' : ' – ' %><%= m.max_amount == null ? 'no max' : fmt(m.max_amount, m.currency) %><% } %></span>
          <a class="btn btn-g btn-sm" href="/withdraw/new?m=<%= m.id %>">Withdraw</a>
        </li>
        <% }) %>
      </ul>
      <% } else { %><p class="muted">No withdrawal methods available.</p><% } %>
    </div>
  </div>

  <div class="card mt">
    <div class="card-h"><h2>Pending requests</h2></div>
    <% if (pending && pending.length) { %>
    <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr><th>ID</th><th>Type</th><th>Amount</th><th>Status</th><th>Created</th></tr></thead>
      <tbody>
        <% pending.forEach(function(p){ %>
        <tr>
          <td><span class="code"><%= p.public_id %></span></td>
          <td><%= p.kind === 'deposit' ? 'Deposit' : 'Withdrawal' %></td>
          <td><%= fmt(p.amount, p.currency) %></td>
          <td><span class="badge b-warn"><%= p.status %></span></td>
          <td><%= new Date(p.created_at).toLocaleString() %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } else { %><p class="muted">No pending requests.</p><% } %>
  </div>

  <div class="card mt">
    <div class="card-h"><h2>Request history</h2></div>
    <% var reqStatusLabels = { pending: 'Pending', approved: 'Approved', rejected: 'Rejected', revoked: 'Revoked', expired: 'Expired', paid: 'Paid' }; %>
    <% if (typeof requests !== 'undefined' && requests && requests.length) { %>
    <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr><th>ID</th><th>Type</th><th>Amount</th><th>Status</th><th>Reason</th><th>Created</th></tr></thead>
      <tbody>
        <% requests.forEach(function(p){ %>
        <tr>
          <td><span class="code"><%= p.public_id %></span></td>
          <td><%= p.kind === 'deposit' ? 'Deposit' : 'Withdrawal' %></td>
          <td><%= fmt(p.amount, p.currency) %></td>
          <td><span class="badge <%= p.status === 'rejected' ? 'b-err' : (p.status === 'approved' || p.status === 'paid' ? 'b-ok' : 'b-warn') %>"><%= reqStatusLabels[p.status] || 'Unknown' %></span></td>
          <td><%= p.reason || '' %></td>
          <td><%= new Date(p.created_at).toLocaleString() %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } else { %><p class="muted">No deposit or withdrawal requests yet.</p><% } %>
  </div>
</section>
