<section class="wrap section narrow-wide">
  <h1 class="sec-title"><%= ticket.subject %> <span class="badge <%= ticket.status === 'open' ? 'b-info' : 'b-muted' %>"><%= ticket.status %></span></h1>
  <div class="card">
    <div class="messages">
      <% (messages || []).forEach(function(m){ %>
      <div class="msg <%= m.mine ? 'mine' : '' %>">
        <div class="msg-head">
          <strong><%= m.mine ? 'You' : 'Support team' %></strong>
          <small class="muted"><%= new Date(m.created_at).toLocaleString() %></small>
        </div>
        <div class="msg-body"><%= m.body %></div>
      </div>
      <% }) %>
    </div>
    <% /* U-18: turn-taking. canReply / lockReason come from the server
         (routes/player.js supportReplyState). Locked → the form is
         REPLACED by the server's reason; open → the form as before.
         A missing local falls back to the pre-v20 behaviour. */ %>
    <% var replyAllowed = (typeof canReply !== 'undefined') ? !!canReply : (ticket.status !== 'closed'); %>
    <% if (replyAllowed) { %>
    <form action="/support/<%= ticket.public_id %>/reply" method="POST" class="mt">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <label for="message">Reply</label>
        <textarea id="message" name="message" rows="4" required></textarea>
      </div>
      <button type="submit" class="btn btn-p">Send Reply</button>
    </form>
    <% } else { %>
    <div class="alert mt" role="note">
      <p><%= (typeof lockReason !== 'undefined' && lockReason) ? lockReason : 'You can reply again as soon as our support team has responded to your last message.' %></p>
    </div>
    <% } %>
    <div class="mt">
      <% if (ticket.status !== 'closed') { %>
      <form action="/support/<%= ticket.public_id %>/close" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button type="submit" class="btn">Close ticket</button>
      </form>
      <% } else { %>
      <form action="/support/<%= ticket.public_id %>/reopen" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button type="submit" class="btn">Reopen ticket</button>
      </form>
      <% } %>
      <% /* U-25: player deletes their OWN ticket. Same pattern as
            close/reopen above: a plain POST form, no confirm — that is
            the app's existing player-side pattern for these actions. */ %>
      <form action="/support/<%= ticket.public_id %>/delete" method="POST" style="margin-top:8px">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button type="submit" class="btn btn-d">Delete ticket</button>
      </form>
    </div>
  </div>
  <p class="mt"><a href="/support">&larr; Back to support</a></p>
</section>
