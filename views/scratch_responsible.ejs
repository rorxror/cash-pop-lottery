<section class="section wrap narrow"><a class="back-link" href="/scratch">← Scratch lobby</a><div class="card"><span class="eyebrow">Responsible play</span><h1>Scratch Play Limits</h1><p class="muted">Daily limits apply before purchase. Cooling-off and self-exclusion only move forward.</p><form method="POST" action="/scratch/responsible-play" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Daily loss limit (0 = no personal limit)<input type="number" min="0" step="0.01" name="daily_loss_limit" value="<%= (Number(limits.daily_loss_limit||0)/100).toFixed(2) %>"></label><label>Session reminder (minutes, 0 = off)<input type="number" min="0" max="1440" name="session_limit_minutes" value="<%= limits.session_limit_minutes||0 %>"></label><label>Start cooling-off (hours)<select name="cooling_off_hours"><option value="0">No new cooling-off</option><option value="24">24 hours</option><option value="168">7 days</option><option value="720">30 days</option></select></label><label>Start self-exclusion<select name="self_exclusion_days"><option value="0">No new self-exclusion</option><option value="30">30 days</option><option value="180">6 months</option><option value="365">1 year</option><option value="3650">10 years</option></select></label><button class="btn btn-p btn-block" type="submit">Save limits</button></form><% if(Number(limits.cooling_off_until)>Date.now()){ %><p class="flash f-err mt">Cooling-off active until <%= new Date(Number(limits.cooling_off_until)).toLocaleString() %>.</p><% } %><% if(Number(limits.self_excluded_until)>Date.now()){ %><p class="flash f-err mt">Self-exclusion active until <%= new Date(Number(limits.self_excluded_until)).toLocaleString() %>.</p><% } %></div></section>
